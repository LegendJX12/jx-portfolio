---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Scene from '../components/Scene.astro';
import ProjectCard from '../components/ProjectCard.astro';
import kinabalu from '../assets/scenes/kinabalu.jpg';
import redang from '../assets/scenes/redang-beach.jpg';
import kl from '../assets/scenes/kl-skyline.jpg';
import georgetown from '../assets/scenes/georgetown.jpg';
import rainforest from '../assets/scenes/rainforest.jpg';

const byNewest = (a: { data: { date: string } }, b: { data: { date: string } }) => b.data.date.localeCompare(a.data.date);
const featured = (await getCollection('projects', (p) => p.data.featured)).sort(byNewest);
const moments = (await getCollection('moments')).sort(byNewest);

const themes = ['Coastal & water', 'Health tech', 'Digital & AI', 'Structures'];

const services = [
  { title: 'Security & blast', text: 'Protective design and blast analysis for buildings and infrastructure at Prostruct Consulting.' },
  { title: 'Coastal & water', text: 'Sea-level-rise ideas, coastal protection and low-energy desalination, from concept to proposal.' },
  { title: 'Project management', text: 'Site inspections, construction management and planning, backed by PMI and Google certificates.' },
  { title: 'Data & code', text: 'Python, MATLAB, SQL and Power BI to turn engineering data into decisions.' },
];

const places = [
  { code: 'MY', name: 'Malaysia', text: 'Home. Hin Hua High School, then a construction internship in Subang Jaya.' },
  { code: 'SG', name: 'Singapore', text: 'NTU Civil Engineering, now Security & Blast Engineer.' },
  { code: 'DE', name: 'Germany', text: 'Exchange semester at the Technical University of Munich.' },
  { code: 'TW', name: 'Taiwan', text: 'Innovation competitions with NCKU: UAiTED and SATU SMART.' },
];
---
<Base>
  <Nav />

  <!-- HERO -->
  <Scene image={kinabalu} eager class="hero">
    <p class="eyebrow">Jin Xie Chai · JX · Singapore</p>
    <h1>Engineering for real problems: coasts, cities and people.</h1>
    <p class="lead">
      Security &amp; Blast Engineer and NTU Civil Engineering graduate. I enter competitions to test
      ideas against real problems, from self-powered desalination to WiFi-sensing healthcare.
    </p>
    <ul class="chips" aria-label="Themes">
      {themes.map((t) => <li><a href="/projects">{t}</a></li>)}
    </ul>
  </Scene>

  <!-- PROJECTS -->
  <Scene image={redang} id="projects">
    <div class="head">
      <div>
        <p class="eyebrow">Explore my projects</p>
        <h2>Competitions, built for real problems</h2>
      </div>
      <a class="btn" href="/projects">See all projects</a>
    </div>
    <div class="rail" tabindex="0" aria-label="Featured projects, scroll sideways">
      {featured.map((p) => <ProjectCard project={p} />)}
    </div>
  </Scene>

  <!-- WHAT I DO -->
  <Scene image={kl} id="what-i-do">
    <p class="eyebrow">What I do</p>
    <h2>From blast loads to sea levels</h2>
    <div class="grid4">
      {services.map((s, i) => (
        <article class="tile">
          <span class="mono num">0{i + 1}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </article>
      ))}
    </div>
  </Scene>

  <!-- PLACES -->
  <Scene image={georgetown} id="places">
    <p class="eyebrow">Where I've been</p>
    <h2>Four places that shaped me</h2>
    <div class="grid4">
      {places.map((p) => (
        <article class="tile">
          <span class="code">{p.code}</span>
          <h3>{p.name}</h3>
          <p>{p.text}</p>
        </article>
      ))}
    </div>
  </Scene>

  <!-- MOMENTS -->
  <Scene image={rainforest} id="moments">
    <p class="eyebrow">Moments</p>
    <h2>Behind the projects</h2>
    {moments.length === 0 ? (
      <p class="tile empty">Photos from competitions, Dean's List, the Munich exchange, CCAs and sport are coming soon.</p>
    ) : (
      <div class="grid3">
        {moments.map((m) => (
          <figure class="moment">
            {m.data.photo && <Image src={m.data.photo} alt={m.data.title} widths={[400, 800]} sizes="(max-width: 860px) 100vw, 380px" format="webp" />}
            <figcaption><strong>{m.data.title}</strong><span class="mono">{m.data.place ? `${m.data.place} · ` : ''}{m.data.date}</span></figcaption>
          </figure>
        ))}
      </div>
    )}
  </Scene>

  <!-- CONTACT (lion dance scene to come; deep red until then) -->
  <Scene id="contact" fallback="var(--deep-red)">
    <p class="eyebrow">Contact</p>
    <h2>Let's build something that holds up.</h2>
    <div class="actions">
      <a class="btn" href="https://www.linkedin.com/in/jin-xie-chai-020112cjx/" rel="noopener">Connect on LinkedIn</a>
    </div>
    <p class="mono small">© {new Date().getFullYear()} Jin Xie Chai</p>
  </Scene>
</Base>

<style>
  .eyebrow { margin: 0 0 12px; font-family: var(--mono); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--yellow); }
  h1 { margin: 0; max-width: 16ch; font-size: clamp(42px, 6.4vw, 84px); line-height: 1; font-weight: 800; letter-spacing: -0.035em; text-shadow: 0 2px 20px rgba(0, 0, 0, 0.35); }
  h2 { margin: 0 0 32px; font-size: clamp(32px, 4vw, 48px); line-height: 1.05; font-weight: 800; letter-spacing: -0.02em; text-shadow: 0 2px 16px rgba(0, 0, 0, 0.35); }
  .lead { max-width: 56ch; margin: 24px 0 0; font-size: 18px; line-height: 1.6; }

  :global(.hero) { min-height: 100vh; min-height: 100svh; display: flex; align-items: center; }
  :global(.hero) :global(.scene-inner) { width: 100%; padding-top: 120px; }

  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 32px 0 0; padding: 0; list-style: none; }
  .chips a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; border-radius: 999px;
    color: #fff; text-decoration: none; font-weight: 600; font-size: 14px;
    background: rgba(255, 255, 255, 0.16); border: 1px solid rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
  }
  .chips a:hover { background: var(--red); border-color: var(--red); color: #fff; }

  .head { display: flex; justify-content: space-between; align-items: end; gap: 16px; flex-wrap: wrap; }
  .btn {
    display: inline-flex; align-items: center; min-height: 48px; padding: 0 22px; border-radius: 10px;
    background: var(--red); color: #fff; font-weight: 700; text-decoration: none; margin-bottom: 32px;
  }
  .btn:hover { background: var(--deep-red); color: #fff; }

  .rail {
    display: grid; grid-auto-flow: column; grid-auto-columns: min(380px, 85vw); gap: 20px;
    overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 12px;
  }
  .rail > :global(*) { scroll-snap-align: start; }

  .grid4 { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  .grid3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  @media (max-width: 960px) { .grid4 { grid-template-columns: repeat(2, minmax(0, 1fr)); } .grid3 { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 560px) { .grid4 { grid-template-columns: minmax(0, 1fr); } }

  .tile {
    margin: 0; padding: 28px; border-radius: 20px;
    background: rgba(12, 18, 50, 0.45); border: 1px solid rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(16px) saturate(1.3); -webkit-backdrop-filter: blur(16px) saturate(1.3);
  }
  .tile h3 { margin: 12px 0 8px; font-size: 22px; font-weight: 800; }
  .tile p { margin: 0; line-height: 1.55; opacity: 0.92; }
  .num { color: var(--yellow); font-size: 13px; }
  .code { font-size: 40px; font-weight: 800; color: var(--yellow); letter-spacing: -0.02em; }
  .empty { max-width: 60ch; }

  .moment { margin: 0; border-radius: 20px; overflow: hidden; background: rgba(12, 18, 50, 0.45); }
  .moment img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .moment figcaption { display: grid; gap: 4px; padding: 16px; }
  .moment .mono { font-size: 12px; opacity: 0.85; }

  .actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .actions .btn { background: #fff; color: var(--deep-red); }
  .actions .btn:hover { background: var(--yellow); color: var(--navy); }
  .small { font-size: 12px; opacity: 0.8; margin: 32px 0 0; }
</style>
