    <div class="glass" style="padding:40px;max-width:560px;margin:16px">
      <p class="mono" style="margin:0;color:var(--muted)">Step 1 check · coming soon</p>
      <h1 style="margin:8px 0 0;font-size:clamp(40px,6vw,72px);font-weight:800;color:var(--navy);letter-spacing:-0.03em">Jin Xie Chai</h1>
      <p style="color:var(--text-2)">Security &amp; Blast Engineer · Singapore</p>
    </div>
  </section>
</Base>
