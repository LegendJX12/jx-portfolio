---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Scene from '../../components/Scene.astro';
import { getProjects, categories, formatDate } from '../../lib/projects';
import panama from '../../assets/scenes/panama-canal.jpg';

const projects = await getProjects();
// Group newest year first: { '2025': [...], '2024': [...] }
const years = Object.entries(Object.groupBy(projects, (p) => p.data.date.slice(0, 4))).sort(([a], [b]) => b.localeCompare(a));
---
<Base title="Projects · Jin Xie Chai (JX)">
  <Nav />

  <Scene image={panama} fallback="linear-gradient(180deg, #3A2F7A 0%, #C35A86 55%, #F7955A 100%)" class="page-hero">
    <p class="eyebrow">All projects · {projects.length}</p>
    <h1>Projects &amp; achievements</h1>
    <div class="filters" role="group" aria-label="Filter by theme">
      <button type="button" aria-pressed="true" data-filter="all">All</button>
      {Object.entries(categories).map(([key, label]) => (
        <button type="button" aria-pressed="false" data-filter={key}>{label}</button>
      ))}
    </div>
  </Scene>

  <section class="wrap list">
    {years.map(([year, items]) => (
      <div class="year" data-year>
        <h2>{year}</h2>
        <ul>
          {items!.map((p) => (
            <li data-category={p.data.category}>
              <a href={`/projects/${p.id}`}>
                <span class="theme mono">{categories[p.data.category]}</span>
                <span class="award">{p.data.award}</span>
                <span class="title">{p.data.title}</span>
                <span class="date mono">{formatDate(p.data.date)}</span>
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
    <p class="empty" id="empty" hidden>No projects in this theme yet.</p>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('[data-category]');
  const empty = document.getElementById('empty')!;
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      let shown = 0;
      items.forEach((el) => {
        const show = f === 'all' || el.dataset.category === f;
        el.hidden = !show;
        if (show) shown++;
      });
      // Hide a whole year when none of its projects match.
      document.querySelectorAll<HTMLElement>('[data-year]').forEach((y) => {
        y.hidden = !y.querySelector('li:not([hidden])');
      });
      empty.hidden = shown > 0;
    }),
  );
</script>

<style>
  .eyebrow { margin: 0 0 12px; font-family: var(--mono); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--yellow); }
  h1 { margin: 0; font-size: clamp(40px, 6vw, 72px); line-height: 1; font-weight: 800; letter-spacing: -0.03em; }
  :global(.page-hero) :global(.scene-inner) { padding-top: 140px; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 32px; }
  .filters button {
    min-height: 44px; padding: 0 18px; border-radius: 999px; cursor: pointer;
    font: 600 14px var(--font); color: #fff;
    background: rgba(255, 255, 255, 0.16); border: 1px solid rgba(255, 255, 255, 0.45);
  }
  .filters button:hover { background: rgba(255, 255, 255, 0.28); }
  .filters button[aria-pressed='true'] { background: var(--red); border-color: var(--red); }
  .list { padding-top: 48px; padding-bottom: 96px; }
  .year { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 24px; padding: 24px 0; border-top: 1px solid #D9D5CA; }
  .year h2 { margin: 0; font-size: 40px; font-weight: 800; color: var(--navy); letter-spacing: -0.02em; line-height: 1.1; }
  .year ul { list-style: none; margin: 0; padding: 0; }
  .year a {
    display: grid; grid-template-columns: 130px 170px minmax(0, 1fr) 90px 24px; gap: 16px; align-items: center;
    min-height: 64px; padding: 12px 16px; border-radius: 12px; text-decoration: none; color: var(--text);
  }
  .year a:hover { background: #fff; box-shadow: 0 6px 20px rgba(20, 32, 92, 0.08); }
  .year li + li a { border-top: 1px solid #ECE7DC; }
  .theme { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; }
  .award { justify-self: start; font-size: 12px; font-weight: 700; color: var(--navy); background: var(--yellow); padding: 4px 10px; border-radius: 999px; }
  .title { font-size: 18px; font-weight: 700; color: var(--navy); }
  .date { font-size: 12px; color: var(--muted); }
  .arrow { color: var(--red); font-weight: 700; }
  @media (max-width: 860px) {
    .year { grid-template-columns: minmax(0, 1fr); gap: 8px; }
    .year a { grid-template-columns: minmax(0, 1fr) 24px; gap: 4px 12px; padding: 14px 8px; }
    .theme, .award, .date { grid-column: 1; }
    .title { grid-column: 1; grid-row: 2; }
    .award { grid-row: 3; }
    .arrow { grid-column: 2; grid-row: 1 / span 3; }
    .date { display: none; }
  }
  .empty { color: var(--muted); }
</style>
