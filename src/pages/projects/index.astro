---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Scene from '../../components/Scene.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects, categories } from '../../lib/projects';

const projects = await getProjects();
---
<Base title="Projects · Jin Xie Chai (JX)">
  <Nav />

  <!-- Langkawi Sky Bridge scene to come; sunset colours until then -->
  <Scene fallback="linear-gradient(180deg, #3A2F7A 0%, #C35A86 55%, #F7955A 100%)" class="page-hero">
    <p class="eyebrow">All projects · {projects.length}</p>
    <h1>Projects &amp; achievements</h1>
    <div class="filters" role="group" aria-label="Filter by theme">
      <button type="button" aria-pressed="true" data-filter="all">All</button>
      {Object.entries(categories).map(([key, label]) => (
        <button type="button" aria-pressed="false" data-filter={key}>{label}</button>
      ))}
    </div>
  </Scene>

  <section class="wrap list">
    <div class="grid" id="project-grid">
      {projects.map((p) => (
        <div data-category={p.data.category}><ProjectCard project={p} /></div>
      ))}
    </div>
    <p class="empty" id="empty" hidden>No projects in this theme yet.</p>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('[data-category]');
  const empty = document.getElementById('empty')!;
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      let shown = 0;
      items.forEach((el) => {
        const show = f === 'all' || el.dataset.category === f;
        el.hidden = !show;
        if (show) shown++;
      });
      empty.hidden = shown > 0;
    }),
  );
</script>

<style>
  .eyebrow { margin: 0 0 12px; font-family: var(--mono); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--yellow); }
  h1 { margin: 0; font-size: clamp(40px, 6vw, 72px); line-height: 1; font-weight: 800; letter-spacing: -0.03em; }
  :global(.page-hero) :global(.scene-inner) { padding-top: 140px; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 32px; }
  .filters button {
    min-height: 44px; padding: 0 18px; border-radius: 999px; cursor: pointer;
    font: 600 14px var(--font); color: #fff;
    background: rgba(255, 255, 255, 0.16); border: 1px solid rgba(255, 255, 255, 0.45);
  }
  .filters button:hover { background: rgba(255, 255, 255, 0.28); }
  .filters button[aria-pressed='true'] { background: var(--red); border-color: var(--red); }
  .list { padding-top: 48px; padding-bottom: 96px; }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  @media (max-width: 960px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .grid { grid-template-columns: minmax(0, 1fr); } }
  .empty { color: var(--muted); }
</style>
