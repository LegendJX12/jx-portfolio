---
const links = [
  { href: '/#projects', label: 'Projects' },
  { href: '/#what-i-do', label: 'What I do' },
  { href: '/#places', label: 'Places' },
  { href: '/#moments', label: 'Moments' },
  { href: '/#contact', label: 'Contact' },
];
---
<header class="nav">
  <div class="wrap nav-inner">
    <a href="/" class="logo" aria-label="Jin Xie Chai, home">JX<span>.</span></a>
    <nav aria-label="Main">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </div>
</header>

<style>
  .nav { position: absolute; top: 0; left: 0; right: 0; z-index: 10; }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-top: 16px; padding-bottom: 16px; }
  .logo { font-size: 28px; font-weight: 800; color: #fff; text-decoration: none; letter-spacing: -0.03em; }
  .logo span { color: var(--yellow); }
  nav { display: flex; gap: 4px; overflow-x: auto; }
  nav a {
    color: #fff; text-decoration: none; font-size: 14px; font-weight: 600;
    padding: 12px 14px; border-radius: 10px; white-space: nowrap;
  }
  nav a:hover { background: rgba(255, 255, 255, 0.16); color: #fff; }
  @media (max-width: 700px) { nav a:not([href$='projects']):not([href$='contact']) { display: none; } }
</style>
