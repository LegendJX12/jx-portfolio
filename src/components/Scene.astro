---
// A full-bleed section sitting on a Malaysian concept-art scene.
// Without an image it falls back to a deep colour (used until the missing scenes arrive).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  id?: string;
  eager?: boolean;
  fallback?: string;
  class?: string;
}
const { image, id, eager = false, fallback = 'var(--navy)', class: cls = '' } = Astro.props;
---
<section id={id} class:list={['scene', cls]} style={`--fallback:${fallback}`}>
  {image && (
    <Image
      src={image}
      alt=""
      class="scene-bg"
      widths={[800, 1200, 1680]}
      sizes="100vw"
      format="webp"
      quality={72}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
    />
  )}
  <div class="scene-shade" aria-hidden="true"></div>
  <div class="wrap scene-inner"><slot /></div>
</section>

<style>
  .scene { position: relative; overflow: hidden; background: var(--fallback); color: #fff; }
  .scene-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .scene-shade {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(10, 16, 48, 0.55) 0%, rgba(10, 16, 48, 0.25) 40%, rgba(10, 16, 48, 0.7) 100%);
  }
  .scene-inner { position: relative; padding-top: 96px; padding-bottom: 96px; }
  @media (max-width: 860px) { .scene-inner { padding-top: 64px; padding-bottom: 64px; } }
</style>
